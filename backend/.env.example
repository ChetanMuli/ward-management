# Copy to backend/.env on the server. Never commit the real .env.

NODE_ENV=production
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ward_management_v1
DB_USER=warddesk
DB_PASSWORD=change-me
DB_DIALECT=mysql
DB_SSL=false

# At least 32 random characters. Generate a new value for live.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=20m
BCRYPT_SALT_ROUNDS=12

OTP_EXPIRY_MINUTES=5

# Comma-separated live frontend origins. Do not use * in production.
CORS_ORIGIN=https://your-domain.com

# Optional. Leave empty until SMTP/SMS is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM_NAME=WardDesk

# Upload folders (writable by the API process)
PORTAL_UPLOAD_DIR=
CHAT_UPLOAD_DIR=

# Production indexes are applied automatically when NODE_ENV=production or npm run db:live.
SCHEMA_SYNC_PRODUCTION_INDEXES=1
SCHEMA_SYNC_REPAIR_ORPHANS=0
SCHEMA_SYNC_RESTORE_CORPORATORS=0
